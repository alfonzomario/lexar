# ─── Configuración de Modelos e IA de Gemini ───

# Modelo a utilizar en la app (por defecto: gemini-3.5-flash)
# Admite gemini-3.5-flash, gemini-2.5-flash, gemini-2.0-flash, etc.
GEMINI_MODEL="gemini-3.5-flash"

# API Key de Gemini
# Obtener en: https://aistudio.google.com/apikey
# NOTA: Para usar en producción con los usuarios gratis y de pago, esta key debe tener
# facturación activada en Google Cloud para no chocar con el límite de 15 peticiones por minuto.
GEMINI_API_KEY="tu-key-paga-aqui"

# APP_URL: The URL where this applet is hosted (optional).
APP_URL="MY_APP_URL"

# Production / deploy (optional; Railway etc. set these automatically)
# PORT=3000
# DATABASE_PATH=/data/lexar.sqlite
